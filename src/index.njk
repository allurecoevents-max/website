---
layout: base.njk
permalink: /index.html
---
{%- from "macros.njk" import hero, heading, gallery, reviews, faq, marquee -%}
{{ hero(home.hero, false) }}

{{ marquee(["Weddings", "Proposals", "Engagements", "Bridal showers", "Baby showers", "Christenings", "Graduations", "Milestone birthdays"]) }}

<div class="trust">
  <ul class="wrap">
    {%- for t in home.trust %}<li>{{ t }}</li>{% endfor %}
  </ul>
</div>

<nav class="chooser" aria-label="What are you planning?">
  <div class="wrap">
    <p class="chooser__label">What are you planning?</p>
    <div class="chooser__grid">
      {%- for s in collections.servicePages %}
      <a class="chooser__item" href="{{ s.url }}">
        <span class="chooser__num">0{{ loop.index }}</span>
        <span class="chooser__title">{{ s.data.title }}</span>
        <span class="chooser__text">{{ s.data.cardText }}</span>
        <span class="chooser__arrow" aria-hidden="true">→</span>
      </a>
      {%- endfor %}
      <a class="chooser__item chooser__item--cta" href="{{ site.calendlyUrl or '#contact' }}"{% if site.calendlyUrl %} target="_blank" rel="noopener"{% endif %}>
        <span class="chooser__num">?</span>
        <span class="chooser__title">Not sure yet?</span>
        <span class="chooser__text">Book a free 30-minute call and we'll help you work it out.</span>
        <span class="chooser__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</nav>

<section class="section">
  <div class="wrap intro-editorial reveal">
    <div>
      <span class="eyebrow">{{ home.intro.eyebrow }}</span>
      <h2>{{ heading(home.intro.heading, home.intro.headingItalic, true) }}</h2>
    </div>
    <p class="lead dropcap">{{ home.intro.text }}</p>
  </div>
</section>

{% if home.journey and home.journey.stages.length %}
<section class="section section--cream journey" id="journey">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{{ home.journey.eyebrow }}</span>
      <h2>{{ heading(home.journey.heading, home.journey.headingItalic, true) }}</h2>
      {% if home.journey.intro %}<p class="lead">{{ home.journey.intro }}</p>{% endif %}
    </div>
    <ol class="journey__grid">
      {%- for st in home.journey.stages %}
      <li class="journey__item reveal">
        <a href="{{ st.link or '#contact' }}">
          <div class="journey__img">{% image st.image, st.imageAlt, "(max-width: 560px) 100vw, (max-width: 960px) 50vw, 300px" %}</div>
          <span class="journey__num">0{{ loop.index }}</span>
          <h3>{{ st.title }}</h3>
          <p>{{ st.text }}</p>
        </a>
      </li>
      {%- endfor %}
    </ol>
    {% if home.journey.offer %}<p class="journey__offer reveal">{{ home.journey.offer }}</p>{% endif %}
  </div>
</section>
{% endif %}

<section class="section section--cream" id="services">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{{ home.services.eyebrow }}</span>
      <h2>{{ home.services.heading }}</h2>
    </div>
    <div class="cards">
      {%- for s in collections.servicePages %}
      <a class="card reveal" href="{{ s.url }}">
        <div class="card__img">{% image s.data.cardImage, s.data.cardImageAlt, "(max-width: 600px) 100vw, (max-width: 960px) 50vw, 380px" %}</div>
        <div class="card__body">
          <h3>{{ s.data.title }}</h3>
          <p>{{ s.data.cardText }}</p>
          <span class="card__more">Explore {{ s.data.title | lower }}</span>
        </div>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section" id="about">
  <div class="wrap split">
    <div class="split__media reveal">
      {% image home.founder.image, home.founder.imageAlt, "(max-width: 860px) 100vw, 560px" %}
      <div class="frame" aria-hidden="true"></div>
    </div>
    <div class="reveal">
      <span class="eyebrow">{{ home.founder.eyebrow }}</span>
      <h2>{{ home.founder.heading }}</h2>
      {{ home.founder.text | paras | safe }}
      {% if home.founder.signature %}<p class="signature">{{ home.founder.signature }}</p>{% endif %}
      <div class="btn-row" style="margin-top:1.6rem">
        <a class="btn" href="#contact">{{ home.founder.button }}</a>
      </div>
    </div>
  </div>
</section>

<section class="section section--ink">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{{ home.process.eyebrow }}</span>
      <h2>{{ home.process.heading }}</h2>
      <p class="lead">{{ home.process.intro }}</p>
    </div>
    <div class="steps">
      {%- for step in home.process.steps %}
      <div class="step reveal"><span class="step__num">{{ "0" if loop.index < 10 }}{{ loop.index }}</span><h3>{{ step.title }}</h3><p>{{ step.text }}</p></div>
      {%- endfor %}
    </div>
  </div>
</section>

{% if home.whyUs and home.whyUs.items.length %}
<section class="section why-us">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{{ home.whyUs.eyebrow }}</span>
      <h2>{{ home.whyUs.heading }}</h2>
    </div>
    <div class="why-us__grid">
      {%- for item in home.whyUs.items %}
      <div class="why-us__item reveal">
        <h3>{{ item.title }}</h3>
        <p>{{ item.text }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="section" id="packages">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{{ home.packages.eyebrow }}</span>
      <h2>{{ home.packages.heading }}</h2>
      <p class="lead">{{ home.packages.intro }}</p>
    </div>
    <div class="packages">
      {%- for p in home.packages.items %}
      <article class="package{% if p.featured %} package--featured{% endif %} reveal">
        {% if p.featured %}<span class="package__badge">Most popular</span>{% endif %}
        <span class="package__tier">{{ p.tier }}</span>
        <h3>{{ p.name }}</h3>
        <p class="package__tag">{{ p.tagline }}</p>
        <ul>
          {%- for f in p.features %}<li>{{ f }}</li>{% endfor %}
        </ul>
        <a class="btn{% if not p.featured %} btn--ghost{% endif %}" href="#contact">{{ p.price or "Enquire for pricing" }}</a>
      </article>
      {%- endfor %}
    </div>
    {% if home.packages.pricingNote %}
    <div class="pricing-note reveal">
      <span class="eyebrow">How pricing works</span>
      <p>{{ home.packages.pricingNote }}</p>
      {% if site.calendlyUrl %}<a class="text-link" href="{{ site.calendlyUrl }}" target="_blank" rel="noopener">Book a free call to get your quote</a>{% endif %}
    </div>
    {% endif %}
    {% if home.packages.addons.length %}
    <div class="addons reveal">
      <span class="eyebrow">{{ home.packages.addonsEyebrow }}</span>
      <p class="lead narrow">{{ home.packages.addonsIntro }}</p>
      <ul>
        {%- for a in home.packages.addons %}<li>{{ a }}</li>{% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>
</section>

{% include "guide-form.njk" %}

{%- set homeReviews ={ eyebrow: home.reviews.eyebrow, heading: home.reviews.heading, items: home.reviews.items, link: "/reviews.html", linkText: "Read all reviews" } -%}
{{ reviews(homeReviews) }}

{% if site.hitchedUrl or site.googleReviewsUrl %}
<div class="find-us">
  <div class="wrap">
    <span class="eyebrow">Find us on</span>
    {% if site.googleReviewsUrl %}<a href="{{ site.googleReviewsUrl }}" target="_blank" rel="noopener">Google <span aria-hidden="true">↗</span></a>{% endif %}
    {% if site.hitchedUrl %}<a href="{{ site.hitchedUrl }}" target="_blank" rel="noopener">Hitched <span aria-hidden="true">↗</span></a>{% endif %}
  </div>
</div>
{% endif %}

<section class="section" id="gallery">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{{ home.gallery.eyebrow }}</span>
      <h2>{{ home.gallery.heading }}</h2>
    </div>
    {{ gallery(home.gallery.images) }}
  </div>
</section>

<section class="section section--cream insta" id="instagram">
  <div class="wrap narrow reveal">
    <span class="eyebrow">{{ home.instagram.eyebrow }}</span>
    <p class="insta__handle">{{ site.instagramHandle }}</p>
    <p class="lead">{{ home.instagram.text }}</p>
    <div class="btn-row" style="justify-content:center">
      <a class="btn" href="{{ site.instagramUrl }}" target="_blank" rel="noopener">Follow on Instagram</a>
      <a class="btn btn--ghost" href="{{ site.tiktokUrl }}" target="_blank" rel="noopener">Follow on TikTok</a>
    </div>
  </div>
  {% if home.instagram.posts and home.instagram.posts.length %}
  <div class="wrap insta-grid reveal">
    {%- for post in home.instagram.posts | batch(6) | first %}
    <a class="insta-grid__item" href="{{ post.link or site.instagramUrl }}" target="_blank" rel="noopener">
      {% image post.image, post.caption or "Instagram post by Allure & Co Events", "(max-width: 600px) 50vw, 200px" %}
    </a>
    {%- endfor %}
  </div>
  {% endif %}
</section>

<section class="section section--ink">
  <div class="wrap magnet">
    <div class="reveal">
      <span class="eyebrow">{{ home.checklist.eyebrow }}</span>
      <h2>{{ home.checklist.heading }}</h2>
      <p class="lead">{{ home.checklist.text }}</p>
    </div>
    <form class="inline-form reveal" action="https://formspree.io/f/{{ site.formspreeId }}" method="POST" data-ajax data-success="/thank-you.html?checklist=1">
      <input type="hidden" name="_subject" value="Checklist download request">
      <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <label class="hp" for="cl-name">First name</label>
      <input id="cl-name" type="text" name="firstName" placeholder="First name" required autocomplete="given-name">
      <label class="hp" for="cl-email">Email</label>
      <input id="cl-email" type="email" name="email" placeholder="Email address" required autocomplete="email">
      <button class="btn btn--light" type="submit">{{ home.checklist.button }}</button>
      <p class="form-status" role="status"></p>
    </form>
  </div>
</section>

{{ faq(home.faq, false, "faq") }}

<section class="section section--cream" id="contact">
  <div class="wrap contact-grid">
    <div class="reveal">
      <span class="eyebrow">{{ home.contact.eyebrow }}</span>
      <h2>{{ home.contact.heading }}</h2>
      <p class="lead">{{ home.contact.text }}</p>
      <ul class="contact-list">
        <li><span>Email</span><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li><span>Instagram</span><a href="{{ site.instagramUrl }}" target="_blank" rel="noopener">{{ site.instagramHandle }}</a></li>
        <li><span>TikTok</span><a href="{{ site.tiktokUrl }}" target="_blank" rel="noopener">{{ site.tiktokHandle }}</a></li>
        <li><span>Based in</span>London, planning across the UK</li>
      </ul>
      {% if home.contact.review and home.contact.review.quote %}
      <figure class="contact-review">
        <div class="quote__stars" aria-label="5 stars">★★★★★</div>
        <blockquote>"{{ home.contact.review.quote }}"</blockquote>
        <figcaption><strong>{{ home.contact.review.name }}</strong>{% if home.contact.review.event %} · {{ home.contact.review.event }}{% endif %}</figcaption>
      </figure>
      {% endif %}
    </div>
    <form class="form enquiry reveal" action="https://formspree.io/f/{{ site.formspreeId }}" method="POST" data-ajax data-enquiry data-success="/thank-you.html?enquiry=1">
      <input type="hidden" name="_subject" value="New enquiry">
      <input type="hidden" name="cameFrom" value="">
      <input type="hidden" name="firstPage" value="">
      <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">

      <fieldset class="field full chips">
        <legend>What are you planning? *</legend>
        <div class="chips__row">
          {%- for t in ["Wedding", "Proposal", "Engagement party", "Bridal shower", "Baby shower", "Birthday or milestone", "Something else"] %}
          <label class="chip"><input type="radio" name="eventType" value="{{ t }}" required><span>{{ t }}</span></label>
          {%- endfor %}
        </div>
      </fieldset>

      <div class="field"><label for="f-first">First name *</label><input id="f-first" name="firstName" required autocomplete="given-name"></div>
      <div class="field"><label for="f-email">Email *</label><input id="f-email" type="email" name="email" required autocomplete="email"></div>
      <div class="field"><label for="f-phone">Phone or WhatsApp</label><input id="f-phone" type="tel" name="phone" autocomplete="tel"></div>
      <div class="field">
        <label for="f-contact">Best way to reach you</label>
        <select id="f-contact" name="contactBy">
          <option>Email</option><option>Phone call</option><option>WhatsApp</option>
        </select>
      </div>

      <div class="field">
        <label for="f-date">Date</label>
        <input id="f-date" type="date" name="eventDate">
        <label class="check"><input type="checkbox" name="dateFlexible" value="Not set yet" id="f-flex"> Not set yet / flexible</label>
      </div>
      <div class="field">
        <label for="f-area">Where?</label>
        <input id="f-area" name="location" placeholder="e.g. Central London, at home">
      </div>

      <div class="field" data-show-for="Wedding">
        <label for="f-venue">Have you booked a venue?</label>
        <select id="f-venue" name="venueBooked">
          <option value="">Please choose</option><option>Yes</option><option>Still looking</option><option>Not started yet</option>
        </select>
      </div>
      <div class="field" data-show-for="Wedding">
        <label for="f-help">How much help would you like?</label>
        <select id="f-help" name="packageInterest">
          <option value="">Please choose</option>
          <option>Final Touch: on-the-day coordination</option>
          <option>Signature: guidance through planning</option>
          <option>Luxe: full planning</option>
          <option>Not sure yet</option>
        </select>
      </div>
      <div class="field full" data-show-for="Proposal">
        <label for="f-secret">Is there anything we should know to keep it a secret?</label>
        <input id="f-secret" name="secretNotes" placeholder="e.g. we share an email, only text me after 6pm">
      </div>
      <div class="field" data-hide-for="Proposal">
        <label for="f-guests">Number of guests</label>
        <select id="f-guests" name="guestCount">
          <option value="">Please choose</option>
          <option>Under 30</option><option>30–80</option><option>80–150</option><option>150+</option><option>Not sure yet</option>
        </select>
      </div>
      <div class="field" data-budget-field>
        <label for="f-budget">Budget for our part</label>
        <select id="f-budget" name="budgetRange" data-budgets='{"Proposal":["Under £500","£500–£1,000","£1,000–£2,500","£2,500+","Not sure yet"],"Wedding":["Under £2,000","£2,000–£5,000","£5,000–£15,000","£15,000+","Not sure yet"],"default":["Under £500","£500–£1,500","£1,500–£3,000","£3,000+","Not sure yet"]}'>
          <option value="">Please choose</option>
          <option>Not sure yet</option>
        </select>
      </div>

      <div class="field full">
        <label for="f-inspo">Share your inspiration (optional)</label>
        <input id="f-inspo" name="inspiration" inputmode="url" placeholder="A Pinterest board, Instagram post or any link you love">
      </div>
      <div class="field full"><label for="f-vision">Tell us a little about it</label><textarea id="f-vision" name="vision" placeholder="The feeling you want, colours, ideas, anything you've seen and loved..."></textarea></div>
      <div class="field full">
        <label for="f-heard">How did you hear about us?</label>
        <select id="f-heard" name="heardAbout">
          <option value="">Please choose</option>
          <option>Instagram</option><option>TikTok</option><option>Google search</option><option>Hitched</option><option>Pinterest</option>
          <option>A venue or supplier</option><option>A friend or past client</option><option>Other</option>
        </select>
      </div>
      <div class="full enquiry__send">
        <button class="btn" type="submit">Send my enquiry</button>
        <p class="enquiry__promise">Free and no obligation · We reply within 24 hours</p>
      </div>
      <p class="form-note full">By sending this form you agree to us contacting you about your enquiry. See our <a href="/privacy.html">privacy policy</a>.</p>
      <p class="form-status" role="status"></p>
    </form>
  </div>
  <div class="wrap calendly-wrap" data-calendly hidden>
    <div class="section-head" style="margin-bottom:28px">
      <span class="eyebrow">Prefer to pick a time?</span>
      <h2>{{ home.contact.calendlyHeading }}</h2>
    </div>
  </div>
</section>
