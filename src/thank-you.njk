      <a class="btn btn--ghost" href="{{ site.instagramUrl }}" target="_blank" rel="noopener">Follow on Instagram</a>
    </div>
  </div>
</section>
<script>
  if (new URLSearchParams(location.search).has("checklist")) {
    document.getElementById("ty-text").textContent = "Your wedding planning checklist is ready. Download it below, and when you're ready to talk planning, we're here.";
    document.getElementById("ty-checklist").hidden = false;
  }
</script>
