---
layout: base.njk
permalink: /portfolio.html
title: Portfolio
description: Real weddings, proposals and celebrations planned by Allure & Co Events.
eleventyComputed:
  noindex: "{{ 'yes' if not collections.caseStudies.length }}"
---
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Portfolio</span>
      <h1>Real events, real stories</h1>
      <p class="lead">A closer look at celebrations we've planned: what our clients wanted, how we brought it to life, and how the day felt.</p>
    </div>
    {% if collections.caseStudies.length %}
    <div class="cards">
      {%- for cs in collections.caseStudies %}
      <a class="card reveal" href="{{ cs.url }}">
        <div class="card__img">{% image cs.data.coverImage, cs.data.coverImageAlt, "(max-width: 600px) 100vw, (max-width: 960px) 50vw, 380px" %}</div>
        <div class="card__body">
          <span class="article-meta">{{ cs.data.eventType }}{% if cs.data.area %} · {{ cs.data.area }}{% endif %}</span>
          <h3>{{ cs.data.title }}</h3>
          <p>{{ cs.data.summary }}</p>
          <span class="card__more">See the story</span>
        </div>
      </a>
      {%- endfor %}
    </div>
    {% else %}
    <p class="center lead">New stories coming soon.</p>
    {% endif %}
  </div>
</section>
