---
layout: base.njk
---
{%- from "macros.njk" import hero as heroSection, split, included as includedSection, gallery as gallerySection, reviews as reviewsSection, faq as faqSection, cta as ctaSection -%}
{{ heroSection(hero) }}

{{ split(intro) }}

{% if steps and steps.items and steps.items.length %}
<section class="section section--ink">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{{ steps.eyebrow or "Step by step" }}</span>
      <h2>{{ steps.heading }}</h2>
      {% if steps.intro %}<p class="lead">{{ steps.intro }}</p>{% endif %}
    </div>
    <div class="steps">
      {%- for step in steps.items %}
      <div class="step reveal"><span class="step__num">0{{ loop.index }}</span><h3>{{ step.title }}</h3><p>{{ step.text }}</p></div>
      {%- endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if types and types.length %}
<section class="section section--cream">
  <div class="wrap">
    {% if typesHeading %}
    <div class="section-head reveal">
      <span class="eyebrow">{{ typesEyebrow or "What we celebrate" }}</span>
      <h2>{{ typesHeading }}</h2>
    </div>
    {% endif %}
    <div class="cards">
      {%- for t in types %}
      <div class="card reveal">
        <div class="card__img">{% image t.image, t.imageAlt, "(max-width: 600px) 100vw, (max-width: 960px) 50vw, 380px" %}</div>
        <div class="card__body"><h3>{{ t.title }}</h3><p>{{ t.text }}</p></div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
{% endif %}

{{ includedSection(included, not (types and types.length)) }}

{% if gallery and gallery.length %}
<section class="section">
  <div class="wrap">{{ gallerySection(gallery) }}</div>
</section>
{% endif %}

{{ reviewsSection(reviews) }}

{% if related and related.items and related.items.length %}
<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{{ related.eyebrow or "Keep reading" }}</span>
      <h2>{{ related.heading or "You might also like" }}</h2>
    </div>
    <div class="related reveal">
      {%- for r in related.items %}
      <a class="related__item" href="{{ r.link }}">
        <span class="related__title">{{ r.title }}</span>
        {% if r.text %}<span class="related__text">{{ r.text }}</span>{% endif %}
        <span class="related__arrow" aria-hidden="true">→</span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
{% endif %}

{% include "guide-form.njk" %}

{{ faqSection(faq) }}

{{ ctaSection(cta, site.calendlyUrl) }}
