{%- set url = page.url or "" -%}
{%- if url == "/" -%}
  {%- set seoTitle = home.seoTitle -%}
  {%- set seoDescription = home.seoDescription -%}
  {%- set ogImage = home.hero.image -%}
{%- endif -%}
{%- set pageTitle = seoTitle or title -%}
{%- set fullTitle = pageTitle if (pageTitle and site.name in pageTitle) else (pageTitle + " | " + site.name) -%}
{%- set image = ogImage or (hero.image if hero) or "/images/img-010.jpg" -%}
{%- set navItems = [
  ["/weddings.html", "Weddings"],
  ["/proposals.html", "Proposals"],
  ["/celebrations.html", "Celebrations"],
  ["/#packages", "Packages"],
  ["/portfolio.html", "Portfolio"] if collections.caseStudies.length,
  ["/journal.html", "Journal"],
  ["/#about", "About"]
] -%}
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {%- if site.googleVerification %}
  <meta name="google-site-verification" content="{{ site.googleVerification }}">
  {%- endif %}
  <title>{{ fullTitle }}</title>
  <meta name="description" content="{{ seoDescription or description }}">
  <link rel="canonical" href="{{ site.url }}{{ url | replace('/index.html', '/') }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ fullTitle }}">
  <meta property="og:description" content="{{ seoDescription or description }}">
  <meta property="og:image" content="{{ site.url }}{{ image }}">
  <link rel="icon" href="/images/img-001.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Jost:wght@300;400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  {%- if url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": {{ site.name | dump | safe }},
    "url": {{ (site.url + "/") | dump | safe }},
    "image": {{ (site.url + image) | dump | safe }},
    "email": {{ site.email | dump | safe }},
    "address": { "@type": "PostalAddress", "addressLocality": "London", "addressCountry": "GB" },
    "areaServed": "United Kingdom",
    "sameAs": [{{ site.instagramUrl | dump | safe }}, {{ site.tiktokUrl | dump | safe }}]
  }
  </script>
  {%- endif %}
</head>
<body data-whatsapp="{{ site.whatsappNumber }}" data-whatsapp-message="{{ site.whatsappMessage }}" data-calendly="{{ site.calendlyUrl }}" data-email="{{ site.email }}">
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap header-inner">
      <a class="logo" href="/" aria-label="{{ site.name }} home">
        <img src="/images/img-001.jpg" alt="">
        <span>Allure &amp; Co</span>
      </a>
      <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav"><span></span><span></span><span></span></button>
      <nav class="nav" id="nav" aria-label="Main">
        {%- for item in navItems %}{% if item %}
        <a href="{{ item[0] }}"{% if item[0] == url or (item[0] == "/journal.html" and "/journal" in url) %} aria-current="page"{% endif %}>{{ item[1] }}</a>
        {%- endif %}{% endfor %}
        <a class="btn" href="/#contact">Book a consultation</a>
      </nav>
    </div>
  </header>

  <main id="main">
{{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <div class="footer-brand">{{ site.name }}</div>
          <p>{{ site.tagline }}</p>
        </div>
        <div>
          <h4>Services</h4>
          <ul>
            {%- for s in collections.servicePages %}
            <li><a href="{{ s.url }}">{{ s.data.title }}</a></li>
            {%- endfor %}
            <li><a href="/#packages">Packages</a></li>
          </ul>
        </div>
        <div>
          <h4>Areas</h4>
          <ul>
            <li><a href="/">London</a></li>
            {%- for a in collections.areaPages %}
            <li><a href="{{ a.url }}">{{ a.data.title }}</a></li>
            {%- endfor %}
          </ul>
        </div>
        <div>
          <h4>Studio</h4>
          <ul>
            <li><a href="/#about">About</a></li>
            {%- if collections.caseStudies.length %}<li><a href="/portfolio.html">Portfolio</a></li>{% endif %}
            <li><a href="/journal.html">Journal</a></li>
            <li><a href="/#faq">FAQ</a></li>
            <li><a href="/privacy.html">Privacy policy</a></li>
          </ul>
        </div>
        <div>
          <h4>Get in touch</h4>
          <ul>
            <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
            <li><a href="{{ site.instagramUrl }}" target="_blank" rel="noopener">Instagram</a></li>
            <li><a href="{{ site.tiktokUrl }}" target="_blank" rel="noopener">TikTok</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© <span data-year>{{ "" | year }}</span> {{ site.name }} · London, UK</span>
        <a href="/#contact">Book a free consultation</a>
      </div>
    </div>
  </footer>

  <a class="whatsapp" href="#" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp" hidden>
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.4-.3z"/></svg>
  </a>

  <script src="/js/main.js"></script>
</body>
</html>
